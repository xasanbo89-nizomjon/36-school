rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================
       YORDAMCHI FUNKSIYALAR
       Rol har doim users/{uid} hujjatidan olinadi (hujjat ID = Auth uid).
       Hujjat yo'q yoki rol noma'lum bo'lsa — "guest": hech narsa qila olmaydi.
       Foydalanuvchi hisoblarini server.js (Firebase Admin) yaratadi.
       ========================= */

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return signedIn() && exists(me()) ? get(me()).data : {};
    }

    function role() {
      return profile().get('role', 'guest');
    }

    function knownRole() {
      return role() in ['superadmin', 'director', 'deputy', 'teacher', 'student', 'parent'];
    }

    function isSuperadmin() { return role() == 'superadmin'; }
    function isAdmin()      { return role() in ['superadmin', 'director']; }
    function isManagement() { return role() in ['superadmin', 'director', 'deputy']; }
    function isStaff()      { return role() in ['superadmin', 'director', 'deputy', 'teacher']; }

    /* Ota-onaning farzandimi */
    function isChild(studentId) {
      return role() == 'parent' && studentId in profile().get('childIds', []);
    }

    function str(value, max) {
      return value is string && value.size() <= max;
    }

    function optStr(data, field, max) {
      return !(field in data) || str(data[field], max);
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOwnCreate() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function keepsCreator() {
      return request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    /* =========================
       USERS
       - o'zini: har kim; ro'yxat: xodimlar; ota-ona: farzandlarini
       - yozish: faqat server (Admin SDK) yoki superadmin
       ========================= */

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff() || isChild(uid));
      allow list: if isStaff();
      allow create, update, delete: if isSuperadmin();
    }

    /* =========================
       CLASSES
       ========================= */

    function validClass(data) {
      return data.keys().hasOnly(['name', 'homeroomTeacherId', 'homeroomTeacherName', 'teacher', 'students', 'createdBy', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && optStr(data, 'homeroomTeacherId', 128)
        && optStr(data, 'homeroomTeacherName', 100)
        && optStr(data, 'teacher', 100)
        && (!('students' in data) || (data.students is int && data.students >= 0 && data.students <= 5000));
    }

    match /classes/{id} {
      allow read: if knownRole();
      allow create: if isManagement() && validClass(request.resource.data) && isOwnCreate();
      allow update: if isManagement() && validClass(request.resource.data) && keepsCreator();
      allow delete: if isManagement();
    }

    /* =========================
       SUBJECTS (fanlar)
       ========================= */

    function validSubject(data) {
      return data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 60;
    }

    match /subjects/{id} {
      allow read: if knownRole();
      allow create: if isManagement() && validSubject(request.resource.data) && isOwnCreate();
      allow update: if isManagement() && validSubject(request.resource.data) && keepsCreator();
      allow delete: if isManagement();
    }

    /* =========================
       LESSONS (dars jadvali). ID = classId_kun_soat
       ========================= */

    function validLesson(id, data) {
      return data.keys().hasOnly(['classId', 'weekday', 'period', 'subjectId', 'subjectName', 'teacherId', 'teacherName', 'room', 'updatedBy', 'updatedAt'])
        && data.keys().hasAll(['classId', 'weekday', 'period', 'subjectId'])
        && str(data.classId, 128) && str(data.subjectId, 128)
        && data.weekday is int && data.weekday >= 1 && data.weekday <= 6
        && data.period is int && data.period >= 1 && data.period <= 8
        && id == data.classId + '_' + string(data.weekday) + '_' + string(data.period)
        && optStr(data, 'subjectName', 60) && optStr(data, 'teacherId', 128)
        && optStr(data, 'teacherName', 100) && optStr(data, 'room', 20)
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    match /lessons/{id} {
      allow read: if knownRole();
      allow create, update: if isManagement() && validLesson(id, request.resource.data);
      allow delete: if isManagement();
    }

    /* =========================
       JOURNAL (elektron jurnal: baho + davomat)
       ID = sana_sinf_fan_o'quvchi. O'quvchi faqat o'zinikini, ota-ona farzandinikini ko'radi.
       ========================= */

    function validJournal(id, data) {
      return data.keys().hasOnly(['studentId', 'classId', 'subjectId', 'date', 'status', 'grade', 'gradeType', 'comment', 'teacherId', 'updatedAt'])
        && data.keys().hasAll(['studentId', 'classId', 'subjectId', 'date', 'status', 'teacherId'])
        && str(data.studentId, 128) && str(data.classId, 128) && str(data.subjectId, 128)
        && isDate(data.date)
        && id == data.date + '_' + data.classId + '_' + data.subjectId + '_' + data.studentId
        && data.status in ['present', 'late', 'excused', 'absent']
        && (!('grade' in data) || (data.grade is int && data.grade >= 1 && data.grade <= 5))
        && (!('gradeType' in data) || data.gradeType in ['daily', 'test', 'exam'])
        && optStr(data, 'comment', 200)
        && data.teacherId == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /journal/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || isChild(resource.data.studentId);
      allow create, update: if isStaff() && validJournal(id, request.resource.data);
      allow delete: if isStaff();
    }

    /* =========================
       HOMEWORK
       yaratish: xodimlar; o'chirish/o'zgartirish: ma'muriyat yoki muallif o'qituvchi
       ========================= */

    function validHomework(data) {
      return data.keys().hasOnly(['title', 'description', 'classId', 'className', 'subjectId', 'subjectName', 'dueDate', 'createdBy', 'createdByName', 'createdAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && optStr(data, 'description', 2000)
        && optStr(data, 'classId', 128) && optStr(data, 'className', 60)
        && optStr(data, 'subjectId', 128) && optStr(data, 'subjectName', 60)
        && optStr(data, 'createdByName', 100)
        && (!('dueDate' in data) || data.dueDate == '' || isDate(data.dueDate));
    }

    match /homework/{id} {
      allow read: if knownRole();
      allow create: if isStaff() && validHomework(request.resource.data) && isOwnCreate();
      allow update: if (isManagement() || (role() == 'teacher' && resource.data.createdBy == request.auth.uid))
        && validHomework(request.resource.data) && keepsCreator();
      allow delete: if isManagement()
        || (role() == 'teacher' && resource.data.createdBy == request.auth.uid);
    }

    /* =========================
       GALLERY — rasm manzili faqat https://
       ========================= */

    function validGallery(data) {
      return data.keys().hasOnly(['title', 'image', 'createdBy', 'createdAt'])
        && data.keys().hasAll(['title', 'image'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.image is string && data.image.size() <= 2000
        && data.image.matches('^https://.+');
    }

    match /gallery/{id} {
      allow read: if knownRole();
      allow create: if isAdmin() && validGallery(request.resource.data) && isOwnCreate();
      allow update: if isAdmin() && validGallery(request.resource.data) && keepsCreator();
      allow delete: if isAdmin();
    }

    /* Eski "attendance" (sinf foizi) yozuvlari — faqat ma'muriyat o'qiy oladi, yangisi jurnalda */
    match /attendance/{id} {
      allow read, delete: if isManagement();
    }

    /* Boshqa hamma narsa — taqiqlangan (default deny) */
  }
}
