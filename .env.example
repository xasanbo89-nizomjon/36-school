# Veb-ilovaning o'zi uchun .env kerak emas.
# Quyidagilar faqat scripts/migrate-users.js (bir martalik migratsiya) uchun.
# Nusxa oling:  cp .env.example .env   — .env faylini git'ga QO'SHMANG.

# Firebase Console -> Project settings -> Service accounts -> "Generate new private key".
# Yuklangan JSON faylning ICHIDAGI HAMMA matnni BITTA qatorga qo'ying.
FIREBASE_SERVICE_ACCOUNT=

# Ixtiyoriy: port (Render buni o'zi beradi)
# PORT=3000
