# Nusxa oling:  cp .env.example .env   — .env faylini git'ga QO'SHMANG.

# Firebase Console -> Project settings -> Service accounts -> "Generate new private key".
# Yuklangan JSON faylning ICHIDAGI HAMMA matnni BITTA qatorga qo'ying.
# Kerak: foydalanuvchi yaratish/parol berish (lib/api-app.js) va scripts/ uchun.
FIREBASE_SERVICE_ACCOUNT=

# O'quvchilar login bilan kiradi: "ali.valiyev" -> "ali.valiyev@36-school.uz".
# public/js/config.js dagi LOGIN_DOMAIN bilan BIR XIL bo'lsin.
LOGIN_DOMAIN=36-school.uz

# API'ga qaysi saytlardan murojaat qilish mumkin (vergul bilan)
ALLOWED_ORIGINS=https://36-school.uz,https://www.36-school.uz,http://localhost:3000

# Ixtiyoriy: lokal port (local-server.js)
# PORT=3000
